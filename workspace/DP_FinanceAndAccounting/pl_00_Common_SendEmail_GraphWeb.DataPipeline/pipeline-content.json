{
  "properties": {
    "description": "Centralized Enterprise SPN-Safe Email Notification Utility Pipeline using Azure Key Vault + Microsoft Graph sendMail API (Resolves UAT #796904 / Issues 1-5).",
    "parameters": {
      "p_failed_pipeline_name": {
        "type": "string",
        "defaultValue": "pl_02_01_01_D365_Entities_Raw_to_EnrichedCurated_FabLink_GeneralLedger"
      },
      "p_failed_run_id": {
        "type": "string",
        "defaultValue": "00000000-0000-0000-0000-000000000000"
      },
      "p_failed_activity_name": {
        "type": "string",
        "defaultValue": "Copy_Entity_Data_Raw_To_Silver"
      },
      "p_error_message": {
        "type": "string",
        "defaultValue": "Smoke Test / Notification Validation"
      }
    },
    "libraryVariables": {
      "Var_GlobalConfig_v_env_name": {
        "type": "String",
        "variableName": "v_env_name",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_key_vault_uri": {
        "type": "String",
        "variableName": "v_key_vault_uri",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_spn_secret_name": {
        "type": "String",
        "variableName": "v_spn_secret_name",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_kv_web_connection_id": {
        "type": "String",
        "variableName": "v_kv_web_connection_id",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_graph_web_connection_id": {
        "type": "String",
        "variableName": "v_graph_web_connection_id",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_tenant_id": {
        "type": "String",
        "variableName": "v_tenant_id",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_spn_client_id": {
        "type": "String",
        "variableName": "v_spn_client_id",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_alert_sender_mailbox": {
        "type": "String",
        "variableName": "v_alert_sender_mailbox",
        "libraryName": "Var_GlobalConfig"
      },
      "Var_GlobalConfig_v_alert_notification_email": {
        "type": "String",
        "variableName": "v_alert_notification_email",
        "libraryName": "Var_GlobalConfig"
      }
    },
    "activities": [
      {
        "name": "Get_SPN_Secret_From_KeyVault",
        "type": "WebActivity",
        "state": "Active",
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "typeProperties": {
          "method": "GET",
          "relativeUrl": {
            "value": "@concat('subscriptions/9e114e9d-1e81-4b56-9ddd-55bae9226770/resourceGroups/rg2/providers/Microsoft.KeyVault/vaults/kv-cox-fabric-cicd-poc/secrets/', pipeline().libraryVariables.Var_GlobalConfig_v_spn_secret_name, '?api-version=2023-07-01')",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "@pipeline().libraryVariables.Var_GlobalConfig_v_kv_web_connection_id"
        }
      },
      {
        "name": "Send_Alert_Via_Microsoft_Graph",
        "type": "WebActivity",
        "state": "Active",
        "dependsOn": [
          {
            "activity": "Get_SPN_Secret_From_KeyVault",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": true,
          "secureOutput": true
        },
        "typeProperties": {
          "method": "POST",
          "relativeUrl": {
            "value": "@concat('v1.0/users/', pipeline().libraryVariables.Var_GlobalConfig_v_alert_sender_mailbox, '/sendMail')",
            "type": "Expression"
          },
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "value": "@json(concat('{\"message\":{\"subject\":\"[', pipeline().libraryVariables.Var_GlobalConfig_v_env_name, '] Fabric Alert: ', pipeline().parameters.p_failed_pipeline_name, ' Failed\",\"body\":{\"contentType\":\"HTML\",\"content\":\"<h3>Microsoft Fabric Enterprise Pipeline Failure</h3><p><b>Environment:</b> ', pipeline().libraryVariables.Var_GlobalConfig_v_env_name, '</p><p><b>Pipeline:</b> ', pipeline().parameters.p_failed_pipeline_name, '</p><p><b>Run ID:</b> ', pipeline().parameters.p_failed_run_id, '</p><p><b>Failed Activity:</b> ', pipeline().parameters.p_failed_activity_name, '</p><p><b>Key Vault Secret Verified:</b> ', pipeline().libraryVariables.Var_GlobalConfig_v_key_vault_uri, 'secrets/', pipeline().libraryVariables.Var_GlobalConfig_v_spn_secret_name, '</p><p><b>Error Details:</b> ', replace(pipeline().parameters.p_error_message, '\"', ''''), '</p>\"},\"toRecipients\":[{\"emailAddress\":{\"address\":\"', pipeline().libraryVariables.Var_GlobalConfig_v_alert_notification_email, '\"}}]},\"saveToSentItems\":false}'))",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "@pipeline().libraryVariables.Var_GlobalConfig_v_graph_web_connection_id"
        }
      }
    ]
  }
}